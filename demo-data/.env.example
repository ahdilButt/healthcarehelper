# Copy this to .env.local (or .env) and fill in real values.
# NEVER commit the real file — add .env.local to .gitignore.

# From Supabase: Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# From Supabase: Project Settings -> API -> service_role key (SECRET — do not use in frontend code)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional — defaults are fine for the hackathon demo login
DEMO_USER_EMAIL=demo@livingrecord.app
DEMO_USER_PASSWORD=demo-password-123!
